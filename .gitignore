.env
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.pyc
*.egg-info/

# Raw ONS workbooks are large and easily regenerated by `ons-mortality fetch`
data/raw/*
!data/raw/.gitkeep

# Processed outputs and figures are small and useful to commit so that the
# rendered notebooks stay readable on GitHub without needing a refresh.
# The bundled small reference CSVs (population, ASMR, COVID deaths) sit
# alongside the regenerated ones; everything in data/processed is checked
# in by intent.
